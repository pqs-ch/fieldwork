<% content_for :width, 'wide' %>
<% content_for :title, 'Supplier imports' %><header class="page-header"><div class="page-header-content"><h1>Supplier imports</h1></div><div class="page-header-actions"><%= link_to 'Import suppliers', new_file_import_import_path, class: 'button', data: { intent: 'primary' } %></div></header>
<section class="stack" aria-labelledby="imports-title"><h2 id="imports-title">Recent imports</h2><% if @store[:batches].empty? %><p class="hint">No imports yet.</p><% else %><ul class="navigation-list" role="list"><% @store[:batches].values.reverse.each do |batch| %><li><a href="<%= batch[:operation] ? file_import_import_path(batch[:id]) : batch[:validation] ? review_file_import_import_path(batch[:id]) : mapping_file_import_import_path(batch[:id]) %>" aria-labelledby="batch-<%= batch[:id] %>-name" aria-describedby="batch-<%= batch[:id] %>-state"><span class="navigation-list-content"><span class="navigation-list-title" id="batch-<%= batch[:id] %>-name"><%= batch[:filename] %></span><span class="navigation-list-description" id="batch-<%= batch[:id] %>-state"><%= batch[:operation] ? 'View confirmed result' : batch[:validation] ? 'Ready for checking · not imported' : 'Map columns · not imported' %></span></span><span class="navigation-list-indicator" aria-hidden="true">→</span></a></li><% end %></ul><% end %></section>
<section class="table-panel"><div class="table-scroll" role="region" aria-label="Supplier register" tabindex="0"><table class="data-table"><caption>Supplier register · <%= pluralize(@store[:suppliers].size,'supplier') %></caption><thead><tr><th scope="col">Reference</th><th scope="col" data-wrap="wrap">Supplier</th><th scope="col" data-wrap="nowrap">Owner email</th></tr></thead><tbody><% @store[:suppliers].each_value do |supplier| %><tr><th scope="row"><%= supplier['reference'] %></th><td data-wrap="wrap"><%= supplier['name'] %></td><td data-wrap="nowrap"><%= supplier['email'] %></td></tr><% end %></tbody></table></div></section>
