<header class="page-header"><div class="page-header-content"><h1>Working agreements for distributed project teams and external contributors</h1>
  <p><% if @unpublished %>Unpublished document · Saved draft<% elsif @historical %>Historical publication <%= @publication[:name] %> · Read-only<% elsif @historical_saved %>Historical saved revision · Read-only<% elsif @revision[:id] == @published[:id] %>Published version <%= @publication[:name] %><% else %>Saved draft · Read-only view<% end %></p>
  <p><%= revision_label(@revision) %> · Recorded by <%= @revision[:owner] %> · <time datetime="<%= @revision[:at] %>"><%= @revision[:at] %></time></p>
  <p>Category: <%= @revision[:category] %></p>
</div><div class="page-header-actions"><a class="button" href="<%= example_url('edit') %>">Edit saved draft</a><a href="<%= example_url('history') %>">History</a></div></header>
<div class="content-surface stack" data-gap="section">
<% if @historical_saved %><div class="revision-notice"><strong>Earlier saved content · Read-only</strong><a href="<%= example_url('read', revision: @draft[:id]) %>">Back to current saved draft</a></div><% end %>
<% if @historical %><div class="revision-notice"><strong>Earlier publication · Read-only</strong><a href="<%= example_url %>">Back to current publication</a></div><% end %>
<% if !@unpublished && @revision[:id] == @published[:id] && (@draft[:body] != @published[:body] || @draft[:category] != @published[:category]) %>
  <div class="notice"><p>A newer saved draft differs from this published edition. Readers are still viewing version 1.1.</p><div class="cluster"><a href="<%= example_url('read', revision: @draft[:id]) %>">Open saved draft</a><a href="<%= example_url('compare', earlier: @published[:id], later: @draft[:id]) %>">Changes since publication</a></div></div>
<% elsif @unpublished %><p class="notice">This document has no published edition.</p>
<% elsif !@publication %><p class="notice">Saved content is shown here. It is not a published edition. <a href="<%= example_url %>">Read latest publication</a></p><% end %>
<% unless @has_sections %><p class="hint">This synthetic app shows arbitrary edited Markdown as escaped source. A consuming application supplies full rendering and section identities.</p><% end %>
<div class="reading-layout"><div class="reading-layout-body">
<% if @has_sections %>
<nav class="reading-contents" data-turbo="false" aria-labelledby="contents-title"><h2 class="reading-contents-title" id="contents-title">On this page</h2><ul role="list">
<% [['purpose','Purpose'],['working-together','Working together'],['response-expectations','Response expectations'],['access','Access examples'],['review','Review cadence'],['contact','Contact']].each do |id, label| %><li><a href="#<%= id %>"><%= label %></a></li><% end %>
</ul></nav>
<% end %>
<article class="rich-content" aria-label="Document content"><%= @html.html_safe %></article>
</div></div>
</div>
