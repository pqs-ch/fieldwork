<% content_for :title, @artifact[:name]; locations = PopulationReview::ReviewEvidence.locations(@store, @artifact[:id]) %>
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><%= link_to 'Evidence library', population_review_evidence_index_path %></li><li><span aria-current="page">Original evidence</span></li></ol></nav>
<header class="page-header"><div class="page-header-content"><h1><%= @artifact[:name] %></h1><p class="page-header-description">Original evidence · managed in this library</p></div><div class="page-header-actions"><% if PopulationReview::ReviewEvidence.available?(@artifact) %><%= link_to 'Download file', download_population_review_evidence_path(@artifact[:id]), download: true, data: {turbo: false}, class: 'button' %><% end %><% unless @artifact[:withdrawn_at] %><%= link_to 'Withdraw original', withdrawal_population_review_evidence_path(@artifact[:id]), class: 'button', data: {variant: 'quiet', intent: 'danger'} %><% end %></div></header>
<% unless PopulationReview::ReviewEvidence.available?(@artifact) %><p class="notice" data-tone="warning"><%= @artifact[:withdrawn_at] ? "Original withdrawn: #{@artifact[:withdrawal_reason]}" : 'This file is unavailable. Its metadata and recorded references are retained.' %></p><% end %>
<div class="content-surface"><div class="section-stack">
<section class="stack" aria-labelledby="evidence-details-heading"><h2 id="evidence-details-heading">Evidence details</h2><dl class="description-list grid"><div><dt>Source</dt><dd><%= @artifact[:source] %></dd></div><div><dt>Evidence date</dt><dd><%= evidence_date(@artifact) %></dd></div><div><dt>File size</dt><dd><%= number_to_human_size(@artifact[:size]) %></dd></div><div><dt>Added by</dt><dd><%= @artifact[:actor] %> · <%= timestamp(@artifact[:added_at]) %></dd></div><% if @artifact[:origin] %><div><dt>Added from</dt><dd><%= link_to 'Source account review', population_review_review_input_path(@artifact[:origin][:review], @artifact[:origin][:input]) %></dd></div><% end %></dl></section>
<section class="stack"><h2>Accounts using this original</h2><% if locations.empty? %><p>No current account links. Earlier assessments can still retain a reference.</p><% else %><ul class="navigation-list"><% locations.each do |location| %><li><%= link_to population_review_review_input_path(location[:review][:id], location[:input][:id], anchor: 'evidence-heading') do %><span class="navigation-list-content"><span class="navigation-list-title"><%= location[:input][:captured][:name] %></span><span class="navigation-list-description"><%= location[:review][:title] %> · <%= review_status(location[:review]) %></span></span><span class="navigation-list-indicator" aria-hidden="true">→</span><% end %></li><% end %></ul><% end %></section>
</div></div>
