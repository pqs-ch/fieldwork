<% content_for :title, 'Withdraw original evidence'; locations = PopulationReview::ReviewEvidence.locations(@store, @artifact[:id]) %>
<header class="page-header"><div class="page-header-content"><h1>Withdraw original evidence</h1><p class="page-header-description"><%= @artifact[:name] %></p></div></header>
<div class="content-surface section-stack">
<section class="stack"><h2>This affects every account using the original</h2><p>Downloads will stop. Metadata, link explanations and past assessment references will remain readable. Unfinished assessments using this original will need reassessment; completed reviews keep their recorded results.</p><p><%= pluralize(locations.size, 'account') %> currently <%= locations.one? ? 'uses' : 'use' %> this original.</p><% if locations.any? %><ul class="review-guidance"><% locations.each do |location| %><li><%= link_to location[:input][:captured][:name], population_review_review_input_path(location[:review][:id], location[:input][:id]), target: '_blank', rel: 'noopener' %> (new tab)</li><% end %></ul><% end %></section>
<%= fieldwork_form_with model: @entry, url: withdraw_population_review_evidence_path(@artifact[:id]), mode: :create, baseline: @baseline, error: @error, id: 'evidence-form', cancel: population_review_evidence_path(@artifact[:id]), data: {draft_protection: 'Withdraw original evidence'}, actions: ->(_form) { button_tag 'Withdraw original', class: 'button', data: {intent: 'danger'} } do |form| %><%= hidden_field_tag :attempt, @attempt %><section class="stack"><%= fieldwork_field form, :reason, type: :textarea, label: 'Withdrawal reason', required: true, rows: 4, maxlength: 1200, hint: 'Explain why this original should no longer be used.' %></section><% end %>
</div>
