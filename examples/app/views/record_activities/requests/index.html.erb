<% content_for :title, 'Service requests' %>
<header class="page-header"><div class="page-header-content"><div class="page-header-title"><h1 id="requests-title">Service requests</h1><span class="badge"><%= @records.count { |record| record[:phase] != 'complete' } %> open</span></div></div></header>
<section class="table-panel" aria-labelledby="requests-title">
<div class="table-scroll" role="region" aria-label="Service request results" tabindex="0"><table class="data-table"><caption class="visually-hidden">Service requests and their next available activity</caption><thead><tr><th scope="col" data-wrap="wrap">Request</th><th scope="col" data-wrap="nowrap">State</th><th scope="col" data-wrap="nowrap">Owner</th><th scope="col">Location</th><th scope="col">Next activity</th></tr></thead><tbody>
<% @records.each do |record| %><tr><td data-wrap="wrap"><a href="<%= record_activities_request_path(record[:id]) %>"><%= record[:title] %></a><p class="hint">SR-<%= record[:id] %></p></td><td data-wrap="nowrap"><span class="status-indicator" <%= 'data-tone=success' if record[:phase] == 'complete' %>><%= state_label(record) %></span></td><td data-wrap="nowrap"><%= record[:owner] %></td><td><%= record[:location] %></td><td><% if (step = RecordActivities::ServiceRequests.next_step(record)) %><a href="<%= new_record_activities_request_activity_path(record[:id], kind: step[:kind]) %>"><%= step[:title] %><span class="visually-hidden"> for SR-<%= record[:id] %></span></a><% else %>Nothing outstanding<% end %></td></tr><% end %>
</tbody></table></div></section>
