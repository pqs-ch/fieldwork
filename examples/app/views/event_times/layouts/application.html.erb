<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? yield(:title) : 'Event records' %> · Operations</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'fieldwork/ui', 'event_times', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags "event_times/application" %>
  <%= stylesheet_link_tag "review", "data-turbo-track": "reload" %>
</head>
<body>
<%= render "review/navigation" %>
<a class="skip-link" href="#main">Skip to content</a>
<div class="application-layout" data-navigation="top"><div class="application-layout-frame">
  <header class="application-layout-compact"><a class="brand" href="/event-times/events"><span>Operations</span></a><div class="stack"><nav class="primary-navigation" aria-label="Compact workspace"><ul class="primary-navigation-list"><li><a href="/event-times/events" aria-current="<%= action_name == 'index' ? 'page' : 'true' %>"><%= fieldwork_icon 'clock' %><span>Event records</span></a></li></ul></nav></div></header>
  <header class="application-layout-top"><div class="application-layout-top-inner"><a class="brand" href="/event-times/events"><span>Operations</span></a><nav class="primary-navigation" data-orientation="horizontal" aria-label="Workspace"><ul class="primary-navigation-list"><li><a href="/event-times/events" aria-current="<%= action_name == 'index' ? 'page' : 'true' %>"><%= fieldwork_icon 'clock' %><span>Event records</span></a></li></ul></nav></div></header>
  <div class="application-layout-content"><main class="application-layout-main page event-times-page stack" data-gap="section" id="main" tabindex="-1">
    <% if flash[:notice] %><p class="notice" data-tone="success" role="status" id="event-result" tabindex="-1"><%= flash[:notice] %></p><% end %>
    <%= yield %>
  </main></div>
</div></div>
</body></html>
