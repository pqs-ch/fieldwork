<% content_for :title,'Purchase requests' %><header class="page-header"><div class="page-header-content"><h1>Purchase requests</h1><p class="page-header-description">Agree a price, discount, quantity and delivery period before recording the request.</p></div><div class="page-header-actions"><%= link_to 'New purchase request',new_purchase_request_purchase_path,class:'button',data:{intent:'primary'} %></div></header>
<div class="content-surface section-stack">
<section class="stack"><h2>Drafts</h2><% drafts=@store[:drafts].reject { |_,draft| draft[:record_id] } %><% if drafts.empty? %><p class="hint">No drafts in this session.</p><% else %><ul><% drafts.each do |id,draft| %><li><%= link_to "Draft for #{PurchaseRequest::PurchaseEntry::SUPPLIERS[draft[:values]['supplier']] || 'supplier'}",new_purchase_request_purchase_path(attempt:id) %></li><% end %></ul><% end %></section>
<section class="stack"><h2>Recorded requests</h2><% if @store[:records].empty? %><p class="hint">No requests recorded yet.</p><% else %><ul><% @store[:records].each do |id,record| %><li><%= link_to "PR-#{id} · #{PurchaseRequest::PurchaseEntry::SUPPLIERS[record[:supplier]]} · #{amount(record[:total_minor],record[:currency])}",purchase_request_purchase_path(id) %></li><% end %></ul><% end %></section>
</div><p class="hint">Synthetic session data expires when the server restarts or reloads application code.</p>
