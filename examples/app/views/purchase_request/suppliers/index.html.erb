<% content_for :title,'Supplier reference' %><header class="page-header"><div class="page-header-content"><h1>Supplier reference</h1><p class="page-header-description">Browse contacts separately from purchase entry.</p></div><%= link_to 'Purchase requests',purchase_request_purchases_path %></header>
<turbo-frame id="supplier-directory" class="stack"><%= render 'lookup',region:@region,generation:@generation %><div class="cluster"><%= link_to 'Regional suppliers',purchase_request_suppliers_path(region:'regional') %><%= link_to 'All suppliers',purchase_request_suppliers_path %></div></turbo-frame>
<%= button_to 'Refresh supplier contacts',purchase_request_suppliers_refresh_path,class:'button',form:{data:{turbo_stream:true}} %>
<section class="panel stack" aria-labelledby="other-lookup"><h2 id="other-lookup">Independent reference</h2><div data-searchable-selection data-label="Independent supplier"><label for="independent-supplier">Independent supplier</label><select id="independent-supplier" name="independent_supplier"><%= options_for_select(PurchaseRequest::PurchaseEntry::SUPPLIERS.map { |id,label| [label,id] }) %></select></div><p class="hint">This independent lookup stays mounted when the directory above refreshes.</p></section>
<section class="stack">
  <h2>Demonstration scenarios</h2><div class="stack"><label class="check"><input type="checkbox" id="keep-reference">Keep the current reference on the next Frame response</label><p class="hint">Search for Slow to try replacing a lookup while its remote search is pending. These scenarios exercise lifecycle recovery without changing a purchase.</p><%= form_with url:purchase_request_suppliers_refresh_path,local:true,data:{turbo_stream:true} do %><%= hidden_field_tag :mode,'update' %><%= button_tag 'Update reference contents',class:'button' %><% end %><p role="status" data-reference-status></p></div></section>
