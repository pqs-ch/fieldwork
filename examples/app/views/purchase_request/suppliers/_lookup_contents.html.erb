<h2 id="lookup-title">Supplier contact lookup</h2><p class="hint">Reference refresh <%= generation %> · <%= region=='regional' ? 'Regional suppliers' : 'All suppliers' %></p>
<div><label for="reference-supplier">Reference supplier</label><select id="reference-supplier" name="reference_supplier"><% PurchaseRequest::PurchaseEntry::SUPPLIERS.each do |id,label| %><% next if region=='regional' && id=='harbor' %><option value="<%= id %>"><%= label %></option><% end %></select></div><p class="hint">Contact details are synthetic: supplier@example.test. Choosing here does not change a purchase request.</p>
