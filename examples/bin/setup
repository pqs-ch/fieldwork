#!/usr/bin/env ruby
require "fileutils"
require "optparse"

skip_server = false
OptionParser.new do |options|
  options.banner = "Usage: bin/setup [--skip-server]"
  options.on("--skip-server", "Check dependencies without starting Rails") { skip_server = true }
end.parse!
abort "Unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?

Dir.chdir(File.expand_path("..", __dir__)) do
  system("bundle", "check") || system("bundle", "install", exception: true)
  FileUtils.mkdir_p(["log", "tmp/pids", "storage"])
  # Synthetic example data are process-local; no database or installer is needed.
  exec "bin/dev" unless skip_server
end
